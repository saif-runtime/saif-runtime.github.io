---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitle } = Astro.locals.starlightRoute;
---

<div class="site-title-group">
	<a href="/docs/" class="site-title sl-flex">
		{
			config.logo && logos.dark && (
				<img alt={config.logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
			)
		}
		<span translate="no">{siteTitle}</span>
	</a>
	<a href="/" class="back-link">
		<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 5 8l5 5" /></svg>
		<span>Back to Saif website</span>
	</a>
</div>

<style>
	.site-title-group {
		display: flex;
		align-items: center;
		gap: 18px;
		min-width: 0;
	}
	.site-title {
		align-items: center;
		gap: 10px;
		font-size: var(--sl-text-h4);
		text-decoration: none;
		white-space: nowrap;
	}
	.site-title img {
		height: 28px;
		width: 28px;
		border-radius: 7px;
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding-left: 18px;
		border-left: 1px solid var(--sl-color-hairline);
		font-size: 14px;
		color: var(--sl-color-gray-4);
		text-decoration: none;
		white-space: nowrap;
	}
	.back-link:hover {
		color: var(--sl-color-text);
	}
	@media (max-width: 640px) {
		.back-link span {
			display: none;
		}
		.back-link {
			padding-left: 12px;
		}
	}
</style>
